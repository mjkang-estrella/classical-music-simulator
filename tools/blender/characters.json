{
  "$comment": "Cast config for tools/blender/build_characters.sh. Rects are normalized texture coords, origin top-left. See recolor_attire.py for the rule format.",
  "repo": "https://github.com/microsoft/Microsoft-Rocketbox",
  "sourceRoot": "vendor/rocketbox/Microsoft-Rocketbox",
  "outputDir": "public/assets/characters",
  "cacheDir": "vendor/rocketbox/cache",
  "previewDir": "vendor/previews",
  "previewFaces": [
    "rocketbox_business_male_01",
    "rocketbox_business_female_01",
    "rocketbox_business_male_05"
  ],
  "twistTest": "rocketbox_business_male_01",
  "defaults": {
    "textureSize": 2048,
    "opacityTextureSize": 1024,
    "glassesTextureSize": 512,
    "imageFormat": "WEBP",
    "imageQuality": 88,
    "alphaCutoff": 0.4,
    "roughness": {
      "body": 0.72,
      "head": 0.55,
      "opacity": 0.88,
      "glasses": 0.3,
      "eyes": 0.05,
      "mouth": 0.2
    },
    "roughnessMap": {
      "enabled": true,
      "targetSkin": 0.5,
      "targetCloth": 0.75,
      "min": 0.25,
      "max": 0.95,
      "skinMask": {
        "hue": [
          0.0,
          0.11
        ],
        "sat": [
          0.2,
          0.85
        ],
        "val": [
          0.2,
          1.0
        ]
      },
      "kRange": [
        1.0,
        16.0
      ],
      "head": {
        "singleK": true,
        "skinRect": [
          0.33,
          0.18,
          0.67,
          0.6
        ]
      },
      "body": {
        "singleK": false
      },
      "blurPx": 1.0,
      "suitMaxVal": 0.3,
      "$comment": "roughness = clamp(1 - k * specular_luminance, min, max), on the specular luminance blurred by blurPx texels. Masks use the recolored colour texture. head: one k per texture, solved so the face skin (skinMask inside skinRect, normalized top-left) averages targetSkin. body: k_skin solved so skin (hands, legs) averages targetSkin, k_cloth so the dark garments (non-skin, HSV value < suitMaxVal = the suit) average targetCloth; blended per pixel by the soft skinMask. k is limited to kRange. Per character: roughnessMap.body.regions = [{name, include rects, target}] gives a garment its own k."
    },
    "twistBones": {
      "enabled": true,
      "fraction": 0.55,
      "smoothstep": [
        0.15,
        1.0
      ],
      "share": 0.85
    },
    "splitMaterials": {
      "enabled": true,
      "eyes": {
        "enabled": true
      },
      "mouth": {
        "enabled": true,
        "uvRect": [
          0.0,
          0.58,
          0.235,
          1.0
        ],
        "belowEyes_m": 0.03,
        "radius_m": 0.075
      },
      "$comment": "eyes: head faces rigidly weighted (>=0.5) to Bip01 LEye/REye (the separate eyeball meshes). mouth: head faces with UV centroid in uvRect (normalized, top-left), > belowEyes_m below the eyes and within radius_m of the lip bones. Materials are named <id>_eyes / <id>_mouth, share the head textures, constant roughness from defaults.roughness."
    },
    "lods": [
      {
        "name": "LOD0",
        "method": "subdivide",
        "levels": 1,
        "quadify": true,
        "quadifyAngle": 40,
        "uvSmooth": "PRESERVE_BOUNDARIES",
        "boundarySmooth": "PRESERVE_CORNERS",
        "limitSurface": false,
        "maxTriangles": 32000,
        "maxError": 0.004,
        "creaseMaterialBorders": [
          "mouth"
        ]
      },
      {
        "name": "LOD1",
        "method": "copy"
      },
      {
        "name": "LOD2",
        "ratio": 0.5,
        "method": "meshopt",
        "maxError": 0.02
      },
      {
        "name": "LOD3",
        "ratio": 0.22,
        "method": "meshopt",
        "maxError": 0.06
      }
    ],
    "skinGuard": {
      "hue": [
        0.02,
        0.11
      ],
      "sat": [
        0.22,
        0.85
      ],
      "val": [
        0.38,
        1.0
      ]
    },
    "recolorFeather": {
      "hue": 0.02,
      "sat": 0.04,
      "val": 0.04
    },
    "recolorHoleFill": 2,
    "doubleSidedAlpha": false
  },
